# PINGCHECK NODE + REACT — NO DOCKER
PORT=4000
# Public privacy and data-deletion contact
PRIVACY_CONTACT_EMAIL=
# Dashboard AI (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CLIENT_URL=http://localhost:5173
# For local use leave these URLs on localhost. In Netlify, set them to your public site URL.
# Example: CLIENT_URL=https://your-site.netlify.app
#          APP_URL=https://your-site.netlify.app
APP_URL=http://localhost:4000
DEMO_MODE=true

# NEON POSTGRESQL (required)
# Neon Dashboard -> Project -> Connect -> copy the pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_POOL_MAX=10

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-before-production

# GOOGLE SIGN-UP / SIGN-IN
# Create a Web Application OAuth client in Google Cloud and paste only the Client ID here.
GOOGLE_CLIENT_ID=

# META / INSTAGRAM LOGIN
# Meta App Dashboard -> Instagram -> API setup -> Instagram App ID (digits only).
# This is not the App Secret and not a Google/OAuth client ID.
META_APP_ID=
META_APP_SECRET=
# In Netlify, use https://your-site.netlify.app/api/integrations/meta/callback
META_REDIRECT_URI=http://localhost:4000/api/integrations/meta/callback
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
META_WEBHOOK_FIELDS=comments,messages
